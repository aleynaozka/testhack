APP_NAME=ISOV Bridge API
ENVIRONMENT=development
AUTH_MODE=demo

# Lovable preview ve yayın adreslerini virgülle ayırın.
CORS_ORIGINS=http://localhost:5173,https://YOUR-PROJECT.lovable.app

# İsteğe bağlı AI. Boş bırakılırsa yerel kural motoru çalışır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Lovable/Supabase oturum tokenini backend'de doğrulamak için.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

